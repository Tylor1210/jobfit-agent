# Copy to .env. Never commit .env.
# Supabase: Project Settings -> Database -> Connection string (URI, session pooler, port 5432)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM provider: anthropic (default, Claude Haiku 5.5) or groq (free tier). See config/models.yaml.
LLM_PROVIDER=anthropic
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DAILY_COST_CAP_USD=1.00

# Langfuse cloud: Settings -> API Keys. Both keys are required for tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU; US projects use https://us.cloud.langfuse.com
