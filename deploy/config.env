# Deploy settings for Cloud Run + Cloudflare. Not secret; secrets live in Google Secret Manager.
GCP_PROJECT=jobcheck-tycodes            # change to your project id
GCP_REGION=us-east1
SERVICE=jobcheck
CF_ACCESS_TEAM_DOMAIN=tycodes.cloudflareaccess.com   # Zero Trust team name + .cloudflareaccess.com
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
